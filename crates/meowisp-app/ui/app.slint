import { ListView, ScrollView } from "std-widgets.slint";

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <brush> accent: #256f5a;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 38px;
    border-radius: 6px;
    background: !root.enabled
        ? #edf1f5
        : touch.pressed
            ? root.accent.darker(0.14)
            : touch.has-hover
                ? root.accent.darker(0.06)
                : root.accent;
    opacity: 1.0;
    border-width: 1px;
    border-color: root.enabled ? root.accent.darker(0.18) : #d9e1ea;

    animate background { duration: 90ms; easing: ease-out; }
    animate border-color { duration: 90ms; easing: ease-out; }
    animate opacity { duration: 120ms; easing: ease-out; }

    Rectangle {
        height: 100%;
        width: parent.width;
        border-radius: root.border-radius;
        background: #ffffff;
        opacity: touch.has-hover && root.enabled ? 0.08 : 0.0;
        animate opacity { duration: 90ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    Text {
        text: root.label;
        color: root.enabled ? #ffffff : #9aa7b6;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    in property <brush> accent: #ffffff;
    in property <brush> text-color: #334155;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 34px;
    border-radius: 6px;
    background: touch.pressed && root.enabled
        ? root.accent.darker(0.08)
        : touch.has-hover && root.enabled
            ? root.accent.darker(0.03)
            : root.accent;
    opacity: root.enabled ? 1.0 : 0.42;
    border-width: 1px;
    border-color: #d7dde5;

    animate background { duration: 90ms; easing: ease-out; }
    animate border-color { duration: 90ms; easing: ease-out; }
    animate opacity { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    Text {
        text: root.label;
        color: root.text-color;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component MenuButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 28px;
    border-radius: 7px;
    background: touch.pressed
        ? #d7ece5
        : root.active
            ? #e3f3ed
            : touch.has-hover
                ? #f3f8f6
                : #ffffff;
    border-width: 1px;
    border-color: root.active ? #b7d8ce : touch.has-hover ? #cfd9e2 : #d7dde5;

    animate background { duration: 85ms; easing: ease-out; }
    animate border-color { duration: 85ms; easing: ease-out; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    Rectangle {
        y: parent.height - 3px;
        x: 8px;
        width: root.active ? parent.width - 16px : touch.has-hover ? parent.width - 24px : 0px;
        height: 2px;
        border-radius: 1px;
        background: #23906f;
        opacity: root.active || touch.has-hover ? 1.0 : 0.0;
        animate width { duration: 110ms; easing: ease-out; }
        animate opacity { duration: 90ms; easing: ease-out; }
    }

    Text {
        text: root.label;
        color: root.active ? #123f35 : #334155;
        font-size: 12px;
        font-weight: root.active ? 760 : 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component HoverRow inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <brush> active-fill: #e9f4f0;
    in property <brush> idle-fill: #f8fafc;
    in property <brush> text-color: #334155;

    height: 32px;
    border-radius: 6px;
    background: root.active ? root.active-fill : touch.has-hover ? #ffffff : root.idle-fill;
    border-width: 1px;
    border-color: root.active ? #b7d8ce : touch.has-hover ? #cbd5e1 : #e2e8f0;

    animate background { duration: 85ms; easing: ease-out; }
    animate border-color { duration: 85ms; easing: ease-out; }

    touch := TouchArea { mouse-cursor: pointer; }

    Rectangle {
        width: root.active ? 3px : touch.has-hover ? 2px : 0px;
        height: parent.height - 10px;
        x: 5px;
        y: 5px;
        border-radius: 2px;
        background: #23906f;
        opacity: root.active || touch.has-hover ? 1.0 : 0.0;
        animate width { duration: 90ms; easing: ease-out; }
        animate opacity { duration: 90ms; easing: ease-out; }
    }

    Text {
        text: root.label;
        color: root.active ? #123f35 : root.text-color;
        font-size: 11px;
        font-weight: root.active ? 720 : 650;
        x: root.active || touch.has-hover ? 13px : 10px;
        vertical-alignment: center;
        overflow: elide;
        animate x { duration: 80ms; easing: ease-out; }
    }
}

component CommandRow inherits Rectangle {
    in property <string> label;
    callback copy;

    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? #f1edff : #f7f4ff;
    border-width: 1px;
    border-color: touch.has-hover ? #cfc4f2 : #ded6f5;

    animate background { duration: 85ms; easing: ease-out; }
    animate border-color { duration: 85ms; easing: ease-out; }

    touch := TouchArea { mouse-cursor: pointer; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.label;
            color: #4d3a8a;
            font-size: 11px;
            font-weight: 650;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        GhostButton {
            width: 54px;
            height: 28px;
            label: "Copy";
            clicked => { root.copy(); }
        }
    }
}

component Panel inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";

    border-radius: 8px;
    background: #ffffff;
    border-width: 1px;
    border-color: #dde3ea;
    clip: true;

    animate border-color { duration: 120ms; easing: ease-out; }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.title;
                color: #16202e;
                font-size: 14px;
                font-weight: 760;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: #66758a;
                font-size: 11px;
                font-weight: 500;
                overflow: elide;
            }
        }

        @children
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <brush> fill: #edf7f2;
    in property <brush> text-color: #16614d;

    height: 24px;
    border-radius: 12px;
    background: root.fill;
    border-width: 1px;
    border-color: root.fill.darker(0.08);

    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

    Text {
        text: root.label;
        color: root.text-color;
        font-size: 10px;
        font-weight: 750;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AppWindow inherits Window {
    in-out property <string> app-version: "dev";
    in-out property <string> ui-font-family: "";
    in-out property <string> brand-font-family: "";
    in-out property <int> cat-mood: 0;
    in-out property <int> active-page: 1;

    in-out property <string> chip-name: "";
    in-out property <string> chip-category: "";
    in-out property <string> chip-family: "";
    in-out property <string> chip-detail: "";
    in-out property <bool> device-connected: false;
    in-out property <string> device-name: "待连接设备";
    in-out property <string> device-category: "待连接";
    in-out property <string> device-family: "";
    in-out property <string> device-chip-id: "";
    in-out property <int> device-flash-size: 0;
    in-out property <int> device-eeprom-size: 0;
    in-out property <string> firmware-name: "未选择固件";
    in-out property <string> firmware-badge: "";
    in-out property <string> firmware-summary: "";
    in-out property <string> firmware-detail: "";
    in-out property <bool> has-firmware: false;
    in-out property <bool> busy: false;
    in-out property <string> log-title: "准备就绪";
    in-out property <string> log-text: "欢迎使用 MeowISP";
    in-out property <string> status-text: "准备就绪";
    in-out property <bool> show-permission-bar: false;
    in-out property <bool> udev-installed: false;
    in-out property <bool> progress-visible: false;
    in-out property <int> progress-value: 0;
    in-out property <string> progress-label: "等待操作";
    in-out property <bool> show-success: false;
    in-out property <string> success-title: "刷写完成";
    in-out property <string> success-text: "";
    in-out property <image> success-animation-image;
    in-out property <bool> show-error: false;
    in-out property <string> error-title: "操作失败";
    in-out property <string> error-text: "";
    in-out property <bool> online-sheet-visible: false;
    in-out property <bool> online-loading: false;
    in-out property <string> online-status: "";
    in-out property <[string]> online-options: [];
    in-out property <[string]> online-subtitles: [];

    in-out property <int> catalog-family-count: 0;
    in-out property <int> catalog-variant-count: 0;
    in-out property <[string]> catalog-family-names: [];
    in-out property <[string]> catalog-family-details: [];
    in-out property <[string]> catalog-variant-rows: [];
    in-out property <[string]> catalog-config-rows: [];
    in-out property <bool> flash-plan-ready: false;
    in-out property <string> flash-plan-summary: "No firmware plan";
    in-out property <string> flash-plan-status: "blocked";
    in-out property <[string]> flash-plan-steps: [];
    in-out property <[string]> flash-plan-risks: [];
    in-out property <bool> project-loaded: false;
    in-out property <string> project-title: "No project loaded";
    in-out property <string> project-subtitle: "Open meowisp.project.toml";
    in-out property <string> project-plan-status: "blocked";
    in-out property <[string]> project-summary-rows: [];
    in-out property <[string]> project-plan-rows: [];
    in-out property <[string]> project-plan-kinds: [];
    in-out property <[string]> project-issue-rows: [];
    in-out property <string> project-ai-command: "meowisp ai project plan --file meowisp.project.toml --json";
    in-out property <string> config-selected-title: "Select a register";
    in-out property <string> config-selected-subtitle: "Field details";
    in-out property <[string]> config-field-rows: [];
    in-out property <[string]> ai-command-rows: [];

    callback request-pick-bin();
    callback request-open-project();
    callback request-probe-device();
    callback request-open-online();
    callback request-refresh-online();
    callback request-close-online();
    callback request-select-online(int);
    callback request-flash-bin();
    callback request-verify-bin();
    callback request-erase-code();
    callback request-erase-data();
    callback request-fix-permission();
    callback request-remove-permission();
    callback request-copy-log();
    callback request-copy-ai-command(int);
    callback request-dismiss-success();
    callback request-dismiss-error();

    title: root.app-version == "dev" ? "Meow WCH ISP dev" : "Meow WCH ISP v" + root.app-version;
    width: 760px;
    height: 520px;
    background: #eef2f5;
    default-font-family: root.ui-font-family;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #eef2f5;

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

                Rectangle {
                    height: 78px;
                    background: #ffffff;
                    border-width: 0px;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width;
                        background: #d9e1ea;
                    }

                    HorizontalLayout {
                        height: 40px;
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 8px;

                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 7px;
                            background: #e9f4f0;
                            border-width: 1px;
                            border-color: #c8ded6;

                            Image {
                                source: root.cat-mood == 3
                                    ? @image-url("../../../assets/crying_cat_3d.png")
                                    : root.cat-mood == 2
                                        ? @image-url("../../../assets/smiling_cat_with_heart-eyes_3d.png")
                                        : @image-url("../../../assets/grinning_cat_3d.png");
                                width: 22px;
                                height: 22px;
                                x: 4px;
                                y: 4px;
                            }
                        }

                        Text {
                            width: 112px;
                            text: "Meow WCH ISP";
                            color: #111827;
                            font-family: root.brand-font-family;
                            font-size: 14px;
                            font-weight: 850;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        MenuButton { width: 58px; label: "Flash"; active: root.active-page == 1 || root.active-page == 0; clicked => { root.active-page = 1; } }
                        MenuButton { width: 64px; label: "Project"; active: root.active-page == 4; clicked => { root.active-page = 4; } }
                        MenuButton { width: 62px; label: "Config"; active: root.active-page == 3; clicked => { root.active-page = 3; } }
                        MenuButton { width: 62px; label: "Memory"; active: root.active-page == 2; clicked => { root.active-page = 2; } }
                        MenuButton { width: 62px; label: "Catalog"; active: root.active-page == 5; clicked => { root.active-page = 5; } }
                        MenuButton { width: 44px; label: "AI"; active: root.active-page == 6; clicked => { root.active-page = 6; } }

                        Rectangle { horizontal-stretch: 1; background: transparent; }

                        StatusPill {
                            width: 92px;
                            label: root.busy ? "BUSY" : root.device-connected ? "CONNECTED" : root.show-permission-bar ? "USB PERM" : "READY";
                            fill: root.busy ? #fff1d6 : root.device-connected ? #e6f5ed : root.show-permission-bar ? #fff2d9 : #edf1f5;
                            text-color: root.busy ? #8a5600 : root.device-connected ? #16614d : root.show-permission-bar ? #805200 : #64748b;
                        }

                        GhostButton {
                            width: 72px;
                            height: 28px;
                            label: "Copy Log";
                            clicked => { root.request-copy-log(); }
                        }
                    }

                    HorizontalLayout {
                        y: 42px;
                        height: 35px;
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            text: root.device-connected ? root.device-name : "No device";
                            color: root.device-connected ? #16614d : #8b5a16;
                            font-size: 12px;
                            font-weight: 750;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.has-firmware ? root.firmware-name : "No firmware selected";
                            color: #475569;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        if root.show-permission-bar: GhostButton {
                            width: 82px;
                            height: 26px;
                            label: "Fix USB";
                            accent: #f1a947;
                            text-color: #ffffff;
                            clicked => { root.request-fix-permission(); }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: #eef2f5;

                    if root.active-page == 0 || root.active-page == 1: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                                Panel {
                                    width: 270px;
                                    title: "Flash";
                                    subtitle: root.flash-plan-ready ? root.flash-plan-summary : "Probe, pick firmware, write.";

                                    VerticalLayout {
                                        spacing: 8px;

                                        PrimaryButton { height: 36px; label: "Probe"; enabled: !root.busy; clicked => { root.request-probe-device(); } }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            GhostButton { horizontal-stretch: 1; height: 34px; label: "Project"; enabled: !root.busy; clicked => { root.request-open-project(); } }
                                            GhostButton { horizontal-stretch: 1; height: 34px; label: "BIN"; enabled: !root.busy; clicked => { root.request-pick-bin(); } }
                                            GhostButton { horizontal-stretch: 1; height: 34px; label: "Online"; enabled: !root.busy; clicked => { root.request-open-online(); } }
                                        }

                                        Rectangle {
                                            height: 82px;
                                            border-radius: 6px;
                                            background: #f8fafc;
                                            border-width: 1px;
                                            border-color: #e2e8f0;

                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 4px;

                                                Text { text: root.firmware-name; color: #152033; font-size: 12px; font-weight: 760; overflow: elide; }
                                                Text { text: root.flash-plan-ready ? root.flash-plan-summary : root.chip-name != "" ? root.chip-name + " · " + root.chip-family : "No target metadata"; color: #64748b; font-size: 10px; overflow: elide; }
                                                Text { text: root.project-loaded ? root.project-title : "Project optional"; color: #64748b; font-size: 10px; overflow: elide; }
                                            }
                                        }

                                        PrimaryButton { height: 38px; label: "Write"; enabled: !root.busy && root.device-connected && root.has-firmware && root.flash-plan-ready; clicked => { root.request-flash-bin(); } }
                                        GhostButton { height: 34px; label: "Verify"; enabled: !root.busy && root.device-connected && root.has-firmware; clicked => { root.request-verify-bin(); } }
                                    }
                                }

                                Panel {
                                    horizontal-stretch: 1;
                                    title: "Plan";
                                    subtitle: root.flash-plan-status == "ready" ? "Ready" : "Waiting";

                                    VerticalLayout {
                                        spacing: 8px;
                                        for step[index] in root.flash-plan-steps: HoverRow {
                                            label: step + " · " + root.flash-plan-risks[index];
                                            active: false;
                                            idle-fill: root.flash-plan-risks[index] == "destructive" ? #fff7e8 : root.flash-plan-risks[index] == "write" ? #effaf4 : #f8fafc;
                                            text-color: root.flash-plan-risks[index] == "destructive" ? #8b5a16 : #334155;
                                        }
                                        if root.flash-plan-steps.length == 0: HoverRow {
                                            height: 44px;
                                            label: "Select firmware to build a guarded plan.";
                                            text-color: #64748b;
                                        }
                                        Rectangle {
                                            height: 58px;
                                            border-radius: 6px;
                                            background: #f8fafc;
                                            border-width: 1px;
                                            border-color: #e2e8f0;
                                            animate background { duration: 120ms; easing: ease-out; }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;

                                                Rectangle {
                                                    width: 4px;
                                                    height: parent.height - 20px;
                                                    border-radius: 2px;
                                                    background: root.busy ? #f1a947 : root.show-error ? #a64f4f : root.show-success ? #23906f : #94a3b8;
                                                    y: 10px;
                                                    animate background { duration: 140ms; easing: ease-out; }
                                                }
                                                VerticalLayout {
                                                    spacing: 3px;
                                                    Text { text: root.log-title; color: #16202e; font-size: 12px; font-weight: 760; overflow: elide; }
                                                    Text { text: root.log-text; color: #64748b; font-size: 10px; overflow: elide; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                    }

                    if root.active-page == 2: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Panel {
                                width: 240px;
                                title: "Regions";
                                subtitle: "Memory map";
                                VerticalLayout {
                                    spacing: 7px;
                                    for row in ["Code flash", "Data flash", "Config", "Bootloader"]: HoverRow { height: 34px; label: row; }
                                }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                title: "Actions";
                                subtitle: "Guarded";
                                VerticalLayout {
                                    spacing: 8px;
                                    GhostButton { height: 34px; label: "Read"; enabled: root.device-connected && !root.busy; }
                                    GhostButton { height: 34px; label: "Import"; enabled: false; }
                                    GhostButton { height: 34px; label: "Erase Plan"; enabled: false; accent: #fff4e7; text-color: #8b4f16; }
                                    Text { text: root.device-connected ? root.device-name : "Connect target first"; color: #64748b; font-size: 11px; overflow: elide; }
                                }
                            }
                        }
                    }

                    if root.active-page == 3: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Panel {
                                width: 250px;
                                title: "Registers";
                                subtitle: root.catalog-config-rows.length + " rows";
                                ListView {
                                    vertical-stretch: 1;
                                    for row[index] in root.catalog-config-rows: HoverRow { label: row; active: index == 0; }
                                }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                title: root.config-selected-title;
                                subtitle: root.config-selected-subtitle;
                                VerticalLayout {
                                    spacing: 8px;
                                    ListView {
                                        vertical-stretch: 1;
                                        for row in root.config-field-rows: HoverRow { height: 34px; label: row; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        GhostButton { horizontal-stretch: 1; height: 32px; label: "Read"; enabled: root.device-connected && !root.busy; }
                                        GhostButton { horizontal-stretch: 1; height: 32px; label: "Diff"; enabled: false; }
                                        GhostButton { horizontal-stretch: 1; height: 32px; label: "Apply"; enabled: false; accent: #fff4e7; text-color: #8b4f16; }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == 4: ScrollView {
                        width: parent.width;
                        height: parent.height;
                        Panel {
                            x: 12px;
                            y: 12px;
                            width: 270px;
                            height: parent.height - 24px;
                            title: "Project";
                            subtitle: root.project-subtitle;
                            VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                GhostButton {
                                    height: 34px;
                                    label: "Open Project";
                                    enabled: !root.busy;
                                    clicked => { root.request-open-project(); }
                                }
                                for row in root.project-summary-rows: HoverRow { height: 34px; label: row; }
                            }
                        }

                        Panel {
                            x: 294px;
                            y: 12px;
                            width: parent.width - 306px;
                            height: parent.height - 24px;
                            title: "Plan";
                            subtitle: root.project-title;
                            VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                for row[index] in root.project-plan-rows: HoverRow {
                                    height: 34px;
                                    label: row;
                                    idle-fill: root.project-plan-kinds[index] == "blocked" ? #fff7e8 : root.project-plan-kinds[index] == "ready" ? #effaf4 : #f8fafc;
                                    text-color: root.project-plan-kinds[index] == "blocked" ? #8b5a16 : #334155;
                                }
                                if root.project-plan-rows.length == 0: HoverRow {
                                    height: 34px;
                                    label: "Open a project file to create a guarded plan.";
                                    text-color: #64748b;
                                }
                                for row in root.project-issue-rows: HoverRow { height: 30px; label: row; idle-fill: #fff7e8; text-color: #8b5a16; }
                                StatusPill {
                                    width: 128px;
                                    label: root.project-plan-status == "ready" ? "PROJECT READY" : "PROJECT BLOCKED";
                                    fill: root.project-plan-status == "ready" ? #e6f5ed : #fff2d9;
                                    text-color: root.project-plan-status == "ready" ? #16614d : #805200;
                                }
                                Rectangle {
                                    height: 58px;
                                    border-radius: 6px;
                                    background: #f7f4ff;
                                    border-width: 1px;
                                    border-color: #ded6f5;
                                    VerticalLayout {
                                        padding: 12px;
                                            spacing: 4px;
                                            Text { text: "AI Entry"; color: #4d3a8a; font-size: 12px; font-weight: 760; overflow: elide; }
                                            Text { text: root.project-ai-command; color: #4d3a8a; font-size: 11px; font-weight: 650; overflow: elide; }
                                        }
                                    }
                                }
                        }
                    }

                    if root.active-page == 5: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            Panel {
                                width: 210px;
                                title: "Families";
                                subtitle: root.catalog-family-count + " families";

                                ListView {
                                    vertical-stretch: 1;
                                    for family[index] in root.catalog-family-names: Rectangle {
                                        height: 42px;
                                        border-radius: 6px;
                                        background: family-touch.has-hover ? #ffffff : #f8fafc;
                                        border-width: 1px;
                                        border-color: family-touch.has-hover ? #cbd5e1 : #e2e8f0;
                                        animate background { duration: 85ms; easing: ease-out; }
                                        animate border-color { duration: 85ms; easing: ease-out; }
                                        family-touch := TouchArea { mouse-cursor: pointer; }
                                        VerticalLayout {
                                            padding: 9px;
                                            spacing: 3px;
                                            Text { text: family; color: #16202e; font-size: 12px; font-weight: 760; overflow: elide; }
                                            Text { text: root.catalog-family-details[index]; color: #64748b; font-size: 10px; overflow: elide; }
                                        }
                                    }
                                }
                            }

                            Panel {
                                horizontal-stretch: 1;
                                title: "Variants";
                                subtitle: root.catalog-variant-count + " devices";

                                ListView {
                                    vertical-stretch: 1;
                                    for row in root.catalog-variant-rows: HoverRow { height: 30px; label: row; }
                                }
                            }

                        }
                    }

                    if root.active-page == 6: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            Panel {
                                horizontal-stretch: 1;
                                title: "State";
                                subtitle: "AI JSON preview";
                                Text { text: "{ device: " + (root.device-connected ? root.device-name : "null") + ", firmware: " + root.firmware-name + ", status: " + root.status-text + " }"; color: #475569; font-size: 12px; wrap: word-wrap; }
                            }

                            Panel {
                                width: 300px;
                                title: "AI Commands";
                                subtitle: "Available now";
                                ListView {
                                    vertical-stretch: 1;
                                    for row[index] in root.ai-command-rows: CommandRow { label: row; copy => { root.request-copy-ai-command(index); } }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: #ffffff;
                    border-width: 0px;

                    Rectangle {
                        height: 1px;
                        width: parent.width;
                        background: #d9e1ea;
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;

                        Text {
                            text: root.progress-label;
                            color: #334155;
                            font-size: 11px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 180px;
                            height: 6px;
                            border-radius: 3px;
                            background: #e2e8f0;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                width: parent.width * root.progress-value / 100;
                                height: parent.height;
                                border-radius: 3px;
                                background: #256f5a;
                                animate width { duration: 180ms; easing: ease; }
                            }
                        }

                        Text {
                            text: root.progress-value + "%";
                            color: #64748b;
                            font-size: 11px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                    }
                }
            }

        if root.online-sheet-visible: Rectangle {
            width: 100%;
            height: 100%;
            background: #101827aa;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 72px;
                width: min(720px, parent.width - 64px);
                height: parent.height - 144px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9e1ea;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Online Firmware"; color: #16202e; font-size: 16px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: root.online-status; color: #64748b; font-size: 11px; vertical-alignment: center; overflow: elide; }
                        GhostButton { width: 78px; label: "Refresh"; enabled: !root.online-loading; clicked => { root.request-refresh-online(); } }
                        GhostButton { width: 70px; label: "Close"; clicked => { root.request-close-online(); } }
                    }

                    ListView {
                        vertical-stretch: 1;
                        enabled: !root.online-loading;

                        for option[index] in root.online-options : Rectangle {
                            height: 54px;
                            border-radius: 6px;
                            background: option-touch.pressed ? #e9f4f0 : option-touch.has-hover ? #f4f7f9 : #ffffff;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            animate background { duration: 100ms; easing: ease; }
                            option-touch := TouchArea {
                                clicked => { root.request-select-online(index); }
                                mouse-cursor: pointer;
                            }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text { text: option; color: #16202e; font-size: 12px; font-weight: 760; overflow: elide; }
                                Text { text: root.online-subtitles[index]; color: #64748b; font-size: 10px; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }

        if root.show-success: Rectangle {
            width: 100%;
            height: 100%;
            background: #10182799;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 330px;
                height: 272px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9e1ea;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: center;

                    Image { source: root.success-animation-image; width: 72px; height: 72px; }
                    Text { text: root.success-title; color: #16202e; font-size: 20px; font-weight: 850; horizontal-alignment: center; }
                    Text { text: root.success-text; color: #64748b; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                    PrimaryButton { width: 100%; height: 38px; label: "Done"; clicked => { root.request-dismiss-success(); } }
                }
            }
        }

        if root.show-error: Rectangle {
            width: 100%;
            height: 100%;
            background: #101827aa;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 360px;
                height: 288px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9e1ea;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: center;

                    Image { source: @image-url("../../../assets/crying_cat_3d.png"); width: 72px; height: 72px; }
                    Text { text: root.error-title; color: #16202e; font-size: 20px; font-weight: 850; horizontal-alignment: center; }
                    Text { text: root.error-text; color: #64748b; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }

                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton { horizontal-stretch: 1; height: 38px; label: "Copy"; clicked => { root.request-copy-log(); } }
                        PrimaryButton { horizontal-stretch: 1; height: 38px; label: "Close"; accent: #7c4b4b; clicked => { root.request-dismiss-error(); } }
                    }
                }
            }
        }
    }
}
