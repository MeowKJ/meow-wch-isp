import { ListView, ScrollView } from "std-widgets.slint";

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <brush> accent: #256f5a;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 38px;
    border-radius: 6px;
    background: !root.enabled
        ? #edf1f5
        : touch.pressed
            ? root.accent.darker(0.14)
            : touch.has-hover
                ? root.accent.darker(0.06)
                : root.accent;
    opacity: 1.0;
    border-width: 1px;
    border-color: root.enabled ? root.accent.darker(0.18) : #d9e1ea;

    animate background { duration: 120ms; easing: ease; }
    animate opacity { duration: 160ms; easing: ease; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    Text {
        text: root.label;
        color: root.enabled ? #ffffff : #9aa7b6;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    in property <brush> accent: #ffffff;
    in property <brush> text-color: #334155;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 34px;
    border-radius: 6px;
    background: touch.pressed && root.enabled
        ? root.accent.darker(0.08)
        : touch.has-hover && root.enabled
            ? root.accent.darker(0.03)
            : root.accent;
    opacity: root.enabled ? 1.0 : 0.42;
    border-width: 1px;
    border-color: #d7dde5;

    animate background { duration: 120ms; easing: ease; }
    animate opacity { duration: 160ms; easing: ease; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    Text {
        text: root.label;
        color: root.text-color;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    background: root.active ? #e9f4f0 : nav-touch.has-hover ? #f4f7f9 : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: #c8ded6;

    animate background { duration: 150ms; easing: ease; }

    nav-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.icon;
            color: root.active ? #16614d : #64748b;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.active ? #123f35 : #445365;
            font-size: 13px;
            font-weight: root.active ? 750 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component Panel inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";

    border-radius: 8px;
    background: #ffffff;
    border-width: 1px;
    border-color: #dde3ea;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.title;
                color: #16202e;
                font-size: 14px;
                font-weight: 760;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: #66758a;
                font-size: 11px;
                font-weight: 500;
                overflow: elide;
            }
        }

        @children
    }
}

component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <brush> accent: #256f5a;

    height: 58px;
    border-radius: 6px;
    background: #f8fafc;
    border-width: 1px;
    border-color: #e2e8f0;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 7px;
        spacing: 3px;

        Text {
            text: root.label;
            color: #64748b;
            font-size: 10px;
            font-weight: 650;
            overflow: elide;
        }

        Text {
            text: root.value;
            color: root.accent;
            font-size: 18px;
            font-weight: 800;
            overflow: elide;
        }
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <brush> fill: #edf7f2;
    in property <brush> text-color: #16614d;

    height: 24px;
    border-radius: 12px;
    background: root.fill;
    border-width: 1px;
    border-color: root.fill.darker(0.08);

    Text {
        text: root.label;
        color: root.text-color;
        font-size: 10px;
        font-weight: 750;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AppWindow inherits Window {
    in-out property <string> app-version: "dev";
    in-out property <string> ui-font-family: "";
    in-out property <string> brand-font-family: "";
    in-out property <int> cat-mood: 0;
    in-out property <int> active-page: 0;

    in-out property <string> chip-name: "";
    in-out property <string> chip-category: "";
    in-out property <string> chip-family: "";
    in-out property <string> chip-detail: "";
    in-out property <bool> device-connected: false;
    in-out property <string> device-name: "待连接设备";
    in-out property <string> device-category: "待连接";
    in-out property <string> device-family: "";
    in-out property <string> device-chip-id: "";
    in-out property <int> device-flash-size: 0;
    in-out property <int> device-eeprom-size: 0;
    in-out property <string> firmware-name: "未选择固件";
    in-out property <string> firmware-badge: "";
    in-out property <string> firmware-summary: "";
    in-out property <string> firmware-detail: "";
    in-out property <bool> has-firmware: false;
    in-out property <bool> busy: false;
    in-out property <string> log-title: "准备就绪";
    in-out property <string> log-text: "欢迎使用 MeowISP";
    in-out property <string> status-text: "准备就绪";
    in-out property <bool> show-permission-bar: false;
    in-out property <bool> udev-installed: false;
    in-out property <bool> progress-visible: false;
    in-out property <int> progress-value: 0;
    in-out property <string> progress-label: "等待操作";
    in-out property <bool> show-success: false;
    in-out property <string> success-title: "刷写完成";
    in-out property <string> success-text: "";
    in-out property <image> success-animation-image;
    in-out property <bool> show-error: false;
    in-out property <string> error-title: "操作失败";
    in-out property <string> error-text: "";
    in-out property <bool> online-sheet-visible: false;
    in-out property <bool> online-loading: false;
    in-out property <string> online-status: "";
    in-out property <[string]> online-options: [];
    in-out property <[string]> online-subtitles: [];

    in-out property <int> catalog-family-count: 0;
    in-out property <int> catalog-variant-count: 0;
    in-out property <[string]> catalog-family-names: [];
    in-out property <[string]> catalog-family-details: [];
    in-out property <[string]> catalog-variant-rows: [];
    in-out property <[string]> catalog-config-rows: [];
    in-out property <bool> flash-plan-ready: false;
    in-out property <string> flash-plan-summary: "No firmware plan";
    in-out property <string> flash-plan-status: "blocked";
    in-out property <[string]> flash-plan-steps: [];
    in-out property <[string]> flash-plan-risks: [];
    in-out property <bool> project-loaded: false;
    in-out property <string> project-title: "No project loaded";
    in-out property <string> project-subtitle: "Open meowisp.project.toml";
    in-out property <string> project-plan-status: "blocked";
    in-out property <[string]> project-summary-rows: [];
    in-out property <[string]> project-plan-rows: [];
    in-out property <[string]> project-plan-kinds: [];
    in-out property <[string]> project-issue-rows: [];
    in-out property <string> project-ai-command: "meowisp ai project plan --file meowisp.project.toml --json";
    in-out property <string> config-selected-title: "Select a register";
    in-out property <string> config-selected-subtitle: "Field details";
    in-out property <[string]> config-field-rows: [];
    in-out property <[string]> ai-command-rows: [];

    callback request-pick-bin();
    callback request-open-project();
    callback request-probe-device();
    callback request-open-online();
    callback request-refresh-online();
    callback request-close-online();
    callback request-select-online(int);
    callback request-flash-bin();
    callback request-verify-bin();
    callback request-erase-code();
    callback request-erase-data();
    callback request-fix-permission();
    callback request-remove-permission();
    callback request-copy-log();
    callback request-copy-ai-command(int);
    callback request-dismiss-success();
    callback request-dismiss-error();

    title: root.app-version == "dev" ? "Meow WCH ISP dev" : "Meow WCH ISP v" + root.app-version;
    width: 1040px;
    height: 720px;
    background: #eef2f5;
    default-font-family: root.ui-font-family;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #eef2f5;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 216px;
                height: parent.height;
                background: #f8fafc;
                border-width: 0px;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: #d9e1ea;
                }

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    padding-top: 18px;
                    padding-bottom: 14px;
                    spacing: 14px;

                    HorizontalLayout {
                        height: 42px;
                        spacing: 10px;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: #e9f4f0;
                            border-width: 1px;
                            border-color: #c8ded6;

                            Image {
                                source: root.cat-mood == 3
                                    ? @image-url("../../../assets/crying_cat_3d.png")
                                    : root.cat-mood == 2
                                        ? @image-url("../../../assets/smiling_cat_with_heart-eyes_3d.png")
                                        : @image-url("../../../assets/grinning_cat_3d.png");
                                width: 26px;
                                height: 26px;
                                x: 4px;
                                y: 4px;
                            }
                        }

                        VerticalLayout {
                            spacing: 1px;

                            Text {
                                text: "Meow WCH ISP";
                                color: #111827;
                                font-family: root.brand-font-family;
                                font-size: 15px;
                                font-weight: 800;
                                overflow: elide;
                            }

                            Text {
                                text: root.app-version == "dev" ? "development build" : "v" + root.app-version;
                                color: #728095;
                                font-size: 10px;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        NavItem { icon: "⌂"; label: "Dashboard"; active: root.active-page == 0; clicked => { root.active-page = 0; } }
                        NavItem { icon: "↯"; label: "Flash"; active: root.active-page == 1; clicked => { root.active-page = 1; } }
                        NavItem { icon: "▦"; label: "Memory"; active: root.active-page == 2; clicked => { root.active-page = 2; } }
                        NavItem { icon: "⚙"; label: "Config"; active: root.active-page == 3; clicked => { root.active-page = 3; } }
                        NavItem { icon: "◇"; label: "Project"; active: root.active-page == 4; clicked => { root.active-page = 4; } }
                        NavItem { icon: "⌕"; label: "Catalog"; active: root.active-page == 5; clicked => { root.active-page = 5; } }
                        NavItem { icon: "AI"; label: "Automation"; active: root.active-page == 6; clicked => { root.active-page = 6; } }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Panel {
                        height: 148px;
                        title: "Session";
                        subtitle: root.device-connected ? root.device-name : "No device";

                        VerticalLayout {
                            spacing: 8px;

                            StatusPill {
                                width: 100%;
                                label: root.busy ? "BUSY" : root.device-connected ? "CONNECTED" : "IDLE";
                                fill: root.busy ? #fff1d6 : root.device-connected ? #e6f5ed : #edf1f5;
                                text-color: root.busy ? #8a5600 : root.device-connected ? #16614d : #64748b;
                            }

                            Text {
                                text: root.status-text;
                                color: #435065;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: 216px;
                y: 0px;
                width: root.width - 216px;
                height: parent.height;
                background: transparent;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0px;

                Rectangle {
                    height: 56px;
                    background: #ffffff;
                    border-width: 0px;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width;
                        background: #d9e1ea;
                    }

                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 18px;
                        spacing: 12px;

                        Text {
                            text: root.active-page == 0 ? "Dashboard"
                                : root.active-page == 1 ? "Flash Operation"
                                : root.active-page == 2 ? "Memory Regions"
                                : root.active-page == 3 ? "Configuration"
                                : root.active-page == 4 ? "Project"
                                : root.active-page == 5 ? "Device Catalog"
                                : "Automation";
                            color: #101827;
                            font-size: 18px;
                            font-weight: 800;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        StatusPill {
                            width: 98px;
                            label: root.show-permission-bar ? "USB PERMISSION" : "USB READY";
                            fill: root.show-permission-bar ? #fff2d9 : #e9f4f0;
                            text-color: root.show-permission-bar ? #805200 : #16614d;
                        }

                        GhostButton {
                            width: 92px;
                            height: 32px;
                            label: "Copy Log";
                            clicked => { root.request-copy-log(); }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: #eef2f5;

                    if root.active-page == 0: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 16px;

                            Panel {
                                height: 128px;
                                title: root.device-connected ? root.device-name : "No WCH ISP device";
                                subtitle: root.device-connected ? root.device-family : "Connect a USB or serial ISP target, then scan or start a guarded plan.";

                                HorizontalLayout {
                                    spacing: 14px;

                                    Metric { horizontal-stretch: 1; label: "Transport"; value: root.device-connected ? "USB" : "None"; }
                                    Metric { horizontal-stretch: 1; label: "Family"; value: root.device-family != "" ? root.device-family : "Unknown"; accent: #5a45a6; }
                                    Metric { horizontal-stretch: 1; label: "Firmware"; value: root.has-firmware ? "Selected" : "Missing"; accent: root.has-firmware ? #256f5a : #9b5f1f; }
                                    Metric { horizontal-stretch: 1; label: "Catalog"; value: root.catalog-variant-count + " chips"; accent: #2f6fa3; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Panel {
                                    horizontal-stretch: 58;
                                    height: 332px;
                                    title: "Available Operations";
                                    subtitle: "Destructive actions stay disabled until device and input are valid.";

                                    VerticalLayout {
                                        spacing: 10px;

                                        Rectangle {
                                            height: 68px;
                                            border-radius: 6px;
                                            background: #f8fafc;
                                            border-width: 1px;
                                            border-color: #e2e8f0;

                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 10px;

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 4px;

                                                    Text { text: root.has-firmware ? root.firmware-name : "No firmware selected"; color: #152033; font-size: 13px; font-weight: 760; overflow: elide; }
                                                    Text { text: root.chip-name != "" ? root.chip-name + " · " + root.chip-family : "BIN file or online release asset"; color: #64748b; font-size: 11px; overflow: elide; }
                                                }

                                                GhostButton { width: 92px; label: "Local BIN"; enabled: !root.busy; clicked => { root.request-pick-bin(); } }
                                                GhostButton { width: 96px; label: "Online"; enabled: !root.busy; clicked => { root.request-open-online(); } }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            PrimaryButton {
                                                horizontal-stretch: 1;
                                                height: 42px;
                                                label: "Apply Flash";
                                                enabled: !root.busy && root.device-connected && root.has-firmware;
                                                clicked => { root.request-flash-bin(); }
                                            }

                                            GhostButton {
                                                horizontal-stretch: 1;
                                                height: 42px;
                                                label: "Verify";
                                                enabled: !root.busy && root.device-connected && root.has-firmware;
                                                clicked => { root.request-verify-bin(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            GhostButton {
                                                horizontal-stretch: 1;
                                                height: 38px;
                                                label: "Erase Codeflash";
                                                accent: #fff4e7;
                                                text-color: #8b4f16;
                                                enabled: false;
                                                clicked => { root.request-erase-code(); }
                                            }

                                            GhostButton {
                                                horizontal-stretch: 1;
                                                height: 38px;
                                                label: "Erase Dataflash";
                                                accent: #fff4e7;
                                                text-color: #8b4f16;
                                                enabled: false;
                                                clicked => { root.request-erase-data(); }
                                            }
                                        }

                                        Text {
                                            text: root.device-connected ? "Flash can be planned after firmware selection. Erase actions will unlock only after a dedicated plan preview lands." : "Write operations are disabled because no target has been identified.";
                                            color: #66758a;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Panel {
                                    horizontal-stretch: 42;
                                    height: 332px;
                                    title: "Health";
                                    subtitle: "Permissions, AI surface and recent event.";

                                    VerticalLayout {
                                        spacing: 10px;

                                        if root.show-permission-bar: Rectangle {
                                            height: 70px;
                                            border-radius: 6px;
                                            background: #fff7e8;
                                            border-width: 1px;
                                            border-color: #f0d19d;

                                            HorizontalLayout {
                                                padding: 12px;
                                                spacing: 10px;

                                                Text { text: "USB permission is not configured."; color: #7a4b00; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                                GhostButton { width: 94px; label: "Install"; accent: #f1a947; text-color: #ffffff; clicked => { root.request-fix-permission(); } }
                                            }
                                        }

                                        Rectangle {
                                            height: 86px;
                                            border-radius: 6px;
                                            background: #f8fafc;
                                            border-width: 1px;
                                            border-color: #e2e8f0;

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 5px;
                                                Text { text: root.log-title; color: #16202e; font-size: 13px; font-weight: 760; overflow: elide; }
                                                Text { text: root.log-text; color: #64748b; font-size: 11px; wrap: word-wrap; }
                                            }
                                        }

                                        Rectangle {
                                            height: 62px;
                                            border-radius: 6px;
                                            background: #f7f4ff;
                                            border-width: 1px;
                                            border-color: #ded6f5;

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 3px;
                                                Text { text: "AI control"; color: #4d3a8a; font-size: 12px; font-weight: 760; }
                                                Text { text: "Catalog endpoint is available. Operation planning is next."; color: #6e62a4; font-size: 11px; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == 1: ScrollView {
                        width: parent.width;
                        height: parent.height;

                            Panel {
                                x: 20px;
                                y: 20px;
                                width: 360px;
                                height: parent.height - 40px;
                                title: "Firmware Source";
                                subtitle: root.device-connected ? root.device-name : "Probe, project, or firmware.";

                                VerticalLayout {
                                    spacing: 10px;
                                    PrimaryButton { height: 40px; label: "Probe Device"; enabled: !root.busy; clicked => { root.request-probe-device(); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        GhostButton { horizontal-stretch: 1; height: 38px; label: "Open Project"; enabled: !root.busy; clicked => { root.request-open-project(); } }
                                        GhostButton { horizontal-stretch: 1; height: 38px; label: "Local BIN"; enabled: !root.busy; clicked => { root.request-pick-bin(); } }
                                    }
                                    GhostButton { height: 38px; label: "Select Online Firmware"; enabled: !root.busy; clicked => { root.request-open-online(); } }
                                    Rectangle {
                                        height: 108px;
                                        border-radius: 6px;
                                        background: #f8fafc;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 4px;
                                            Text { text: root.firmware-name; color: #152033; font-size: 13px; font-weight: 760; overflow: elide; }
                                            Text { text: root.flash-plan-ready ? root.flash-plan-summary : root.chip-name != "" ? root.chip-name + " · " + root.chip-family : "No parsed target metadata"; color: #64748b; font-size: 11px; overflow: elide; }
                                            Text { text: root.device-connected ? "Device: " + root.device-name : "Device: not detected"; color: root.device-connected ? #16614d : #8b5a16; font-size: 11px; font-weight: 650; overflow: elide; }
                                        }
                                    }
                                }
                            }

                            Panel {
                                x: 396px;
                                y: 20px;
                                width: parent.width - 416px;
                                height: parent.height - 40px;
                                title: "Operation Plan";
                                subtitle: root.flash-plan-summary;

                                VerticalLayout {
                                    spacing: 9px;
                                    for step[index] in root.flash-plan-steps: Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: root.flash-plan-risks[index] == "destructive" ? #fff7e8 : root.flash-plan-risks[index] == "write" ? #effaf4 : #f8fafc;
                                        border-width: 1px;
                                        border-color: root.flash-plan-risks[index] == "destructive" ? #f0d19d : #e2e8f0;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text { text: step; color: #1f2937; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: root.flash-plan-risks[index]; color: root.flash-plan-risks[index] == "destructive" ? #8b5a16 : root.flash-plan-risks[index] == "write" ? #16614d : #64748b; font-size: 11px; vertical-alignment: center; }
                                        }
                                    }
                                    if root.flash-plan-steps.length == 0: Rectangle {
                                        height: 46px;
                                        border-radius: 6px;
                                        background: #f8fafc;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        Text { text: "No plan yet. Select a firmware file or online release."; color: #64748b; font-size: 12px; x: 12px; vertical-alignment: center; overflow: elide; }
                                    }
                                    StatusPill {
                                        width: 112px;
                                        label: root.flash-plan-status == "ready" ? "PLAN READY" : "PLAN BLOCKED";
                                        fill: root.flash-plan-status == "ready" ? #e6f5ed : #fff2d9;
                                        text-color: root.flash-plan-status == "ready" ? #16614d : #805200;
                                    }
                                    PrimaryButton { height: 42px; label: "Apply Flash"; enabled: !root.busy && root.device-connected && root.has-firmware && root.flash-plan-ready; clicked => { root.request-flash-bin(); } }
                                }
                            }
                    }

                    if root.active-page == 2: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 20px;
                            spacing: 16px;
                            Panel {
                                width: 280px;
                                title: "Regions";
                                subtitle: "Capability-driven memory map.";
                                VerticalLayout {
                                    spacing: 8px;
                                    for row in ["Code flash · read/write/erase", "Data flash · read/write/erase", "Config · read first", "Bootloader · protected"]: Rectangle {
                                        height: 44px;
                                        border-radius: 6px;
                                        background: #f8fafc;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        Text { text: row; color: #334155; font-size: 12px; font-weight: 650; x: 10px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                title: "Inspector";
                                subtitle: "Read/export, write/import and erase controls are visible but guarded.";
                                VerticalLayout {
                                    spacing: 10px;
                                    GhostButton { height: 38px; label: "Read Selected Region"; enabled: root.device-connected && !root.busy; }
                                    GhostButton { height: 38px; label: "Import and Plan Write"; enabled: false; }
                                    GhostButton { height: 38px; label: "Plan Erase"; enabled: false; accent: #fff4e7; text-color: #8b4f16; }
                                    Text { text: "Hex preview and exported files will land here in the next implementation pass."; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    if root.active-page == 3: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 20px;
                            spacing: 16px;
                            Panel {
                                width: 280px;
                                title: "Registers";
                                subtitle: root.catalog-config-rows.length + " schema rows";
                                ListView {
                                    vertical-stretch: 1;
                                    for row[index] in root.catalog-config-rows: Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: index == 0 ? #e9f4f0 : #f8fafc;
                                        border-width: 1px;
                                        border-color: index == 0 ? #c8ded6 : #e2e8f0;
                                        Text { text: row; color: index == 0 ? #123f35 : #334155; font-size: 11px; font-weight: 650; x: 10px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                title: root.config-selected-title;
                                subtitle: root.config-selected-subtitle;
                                VerticalLayout {
                                    spacing: 8px;
                                    for row in root.config-field-rows: Rectangle {
                                        height: 42px;
                                        border-radius: 6px;
                                        background: #f8fafc;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        Text { text: row; color: #334155; font-size: 12px; font-weight: 650; x: 12px; vertical-alignment: center; }
                                    }
                                }
                            }
                            Panel {
                                width: 300px;
                                title: "Inspector";
                                subtitle: "Enum meanings, raw bits and constraints.";
                                VerticalLayout {
                                    spacing: 10px;
                                    Text { text: "Config editing will stay guarded: read current value, preview target diff, then apply only after an explicit plan."; color: #64748b; font-size: 12px; wrap: word-wrap; }
                                    GhostButton { height: 38px; label: "Read Config"; enabled: root.device-connected && !root.busy; }
                                    GhostButton { height: 38px; label: "Plan Config Diff"; enabled: false; }
                                    GhostButton { height: 38px; label: "Apply Config"; enabled: false; accent: #fff4e7; text-color: #8b4f16; }
                                }
                            }
                        }
                    }

                    if root.active-page == 4: ScrollView {
                        width: parent.width;
                        height: parent.height;
                        Panel {
                            x: 20px;
                            y: 20px;
                            width: 320px;
                            height: parent.height - 40px;
                            title: "Project File";
                            subtitle: root.project-subtitle;
                            VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                GhostButton {
                                    height: 38px;
                                    label: "Open Project";
                                    enabled: !root.busy;
                                    clicked => { root.request-open-project(); }
                                }
                                for row in root.project-summary-rows: Rectangle {
                                    height: 40px;
                                    border-radius: 6px;
                                    background: #f8fafc;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    Text { text: row; color: #334155; font-size: 12px; font-weight: 650; x: 10px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }

                        Panel {
                            x: 356px;
                            y: 20px;
                            width: parent.width - 376px;
                            height: parent.height - 40px;
                            title: "Plan Preview";
                            subtitle: root.project-title;
                            VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                for row[index] in root.project-plan-rows: Rectangle {
                                    height: 42px;
                                    border-radius: 6px;
                                    background: root.project-plan-kinds[index] == "blocked" ? #fff7e8 : root.project-plan-kinds[index] == "ready" ? #effaf4 : #f8fafc;
                                    border-width: 1px;
                                    border-color: root.project-plan-kinds[index] == "blocked" ? #f0d19d : #e2e8f0;
                                    Text { text: row; color: root.project-plan-kinds[index] == "blocked" ? #8b5a16 : #334155; font-size: 12px; font-weight: 650; x: 12px; vertical-alignment: center; overflow: elide; }
                                }
                                if root.project-plan-rows.length == 0: Rectangle {
                                    height: 42px;
                                    border-radius: 6px;
                                    background: #f8fafc;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    Text { text: "Open a project file to create a guarded plan."; color: #64748b; font-size: 12px; font-weight: 650; x: 12px; vertical-alignment: center; overflow: elide; }
                                }
                                for row in root.project-issue-rows: Rectangle {
                                    height: 36px;
                                    border-radius: 6px;
                                    background: #fff7e8;
                                    border-width: 1px;
                                    border-color: #f0d19d;
                                    Text { text: row; color: #8b5a16; font-size: 11px; font-weight: 650; x: 12px; vertical-alignment: center; overflow: elide; }
                                }
                                StatusPill {
                                    width: 128px;
                                    label: root.project-plan-status == "ready" ? "PROJECT READY" : "PROJECT BLOCKED";
                                    fill: root.project-plan-status == "ready" ? #e6f5ed : #fff2d9;
                                    text-color: root.project-plan-status == "ready" ? #16614d : #805200;
                                }
                                Rectangle {
                                    height: 72px;
                                    border-radius: 6px;
                                    background: #f7f4ff;
                                    border-width: 1px;
                                    border-color: #ded6f5;
                                    VerticalLayout {
                                        padding: 12px;
                                            spacing: 4px;
                                            Text { text: "AI Entry"; color: #4d3a8a; font-size: 12px; font-weight: 760; overflow: elide; }
                                            Text { text: root.project-ai-command; color: #4d3a8a; font-size: 12px; font-weight: 650; wrap: word-wrap; }
                                        }
                                    }
                                }
                        }
                    }

                    if root.active-page == 5: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 20px;
                            spacing: 16px;

                            Panel {
                                width: 260px;
                                title: "Families";
                                subtitle: root.catalog-family-count + " families";

                                ListView {
                                    vertical-stretch: 1;
                                    for family[index] in root.catalog-family-names: Rectangle {
                                        height: 54px;
                                        border-radius: 6px;
                                        background: family-touch.has-hover ? #f1f5f9 : #ffffff;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        animate background { duration: 120ms; easing: ease; }
                                        family-touch := TouchArea { mouse-cursor: pointer; }
                                        VerticalLayout {
                                            padding: 9px;
                                            spacing: 3px;
                                            Text { text: family; color: #16202e; font-size: 12px; font-weight: 760; overflow: elide; }
                                            Text { text: root.catalog-family-details[index]; color: #64748b; font-size: 10px; overflow: elide; }
                                        }
                                    }
                                }
                            }

                            Panel {
                                horizontal-stretch: 1;
                                title: "Variants";
                                subtitle: root.catalog-variant-count + " supported devices from rs-wchisp";

                                ListView {
                                    vertical-stretch: 1;
                                    for row in root.catalog-variant-rows: Rectangle {
                                        height: 34px;
                                        border-radius: 5px;
                                        background: #f8fafc;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        Text { text: row; color: #334155; font-size: 11px; font-weight: 600; x: 10px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }

                            Panel {
                                width: 260px;
                                title: "Filters";
                                subtitle: "Read-only catalog controls.";

                                VerticalLayout {
                                    spacing: 8px;
                                    for row in ["USB supported", "Serial supported", "Has config registers", "Has data flash", "Family prefix"]: Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        background: #f8fafc;
                                        border-width: 1px;
                                        border-color: #e2e8f0;
                                        Text { text: row; color: #334155; font-size: 12px; font-weight: 650; x: 10px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == 6: ScrollView {
                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding: 20px;
                            spacing: 16px;

                            Panel {
                                horizontal-stretch: 1;
                                title: "Current State JSON";
                                subtitle: "AI-facing app state preview.";
                                Text { text: "{ device: " + (root.device-connected ? root.device-name : "null") + ", firmware: " + root.firmware-name + ", status: " + root.status-text + " }"; color: #475569; font-size: 12px; wrap: word-wrap; }
                            }

                            Panel {
                                width: 320px;
                                title: "AI Commands";
                                subtitle: "Available now";
                                VerticalLayout {
                                    spacing: 8px;
                                    for row[index] in root.ai-command-rows: Rectangle {
                                        height: 42px;
                                        border-radius: 6px;
                                        background: #f7f4ff;
                                        border-width: 1px;
                                        border-color: #ded6f5;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            Text { text: row; color: #4d3a8a; font-size: 11px; font-weight: 650; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            GhostButton { width: 54px; height: 28px; label: "Copy"; clicked => { root.request-copy-ai-command(index); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: #ffffff;
                    border-width: 0px;

                    Rectangle {
                        height: 1px;
                        width: parent.width;
                        background: #d9e1ea;
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;

                        Text {
                            text: root.progress-label;
                            color: #334155;
                            font-size: 11px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 180px;
                            height: 6px;
                            border-radius: 3px;
                            background: #e2e8f0;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                width: parent.width * root.progress-value / 100;
                                height: parent.height;
                                border-radius: 3px;
                                background: #256f5a;
                                animate width { duration: 180ms; easing: ease; }
                            }
                        }

                        Text {
                            text: root.progress-value + "%";
                            color: #64748b;
                            font-size: 11px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.online-sheet-visible: Rectangle {
            width: 100%;
            height: 100%;
            background: #101827aa;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 72px;
                width: min(720px, parent.width - 64px);
                height: parent.height - 144px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9e1ea;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Online Firmware"; color: #16202e; font-size: 16px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: root.online-status; color: #64748b; font-size: 11px; vertical-alignment: center; overflow: elide; }
                        GhostButton { width: 78px; label: "Refresh"; enabled: !root.online-loading; clicked => { root.request-refresh-online(); } }
                        GhostButton { width: 70px; label: "Close"; clicked => { root.request-close-online(); } }
                    }

                    ListView {
                        vertical-stretch: 1;
                        enabled: !root.online-loading;

                        for option[index] in root.online-options : Rectangle {
                            height: 54px;
                            border-radius: 6px;
                            background: option-touch.pressed ? #e9f4f0 : option-touch.has-hover ? #f4f7f9 : #ffffff;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            animate background { duration: 100ms; easing: ease; }
                            option-touch := TouchArea {
                                clicked => { root.request-select-online(index); }
                                mouse-cursor: pointer;
                            }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text { text: option; color: #16202e; font-size: 12px; font-weight: 760; overflow: elide; }
                                Text { text: root.online-subtitles[index]; color: #64748b; font-size: 10px; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }

        if root.show-success: Rectangle {
            width: 100%;
            height: 100%;
            background: #10182799;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 330px;
                height: 272px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9e1ea;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: center;

                    Image { source: root.success-animation-image; width: 72px; height: 72px; }
                    Text { text: root.success-title; color: #16202e; font-size: 20px; font-weight: 850; horizontal-alignment: center; }
                    Text { text: root.success-text; color: #64748b; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                    PrimaryButton { width: 100%; height: 38px; label: "Done"; clicked => { root.request-dismiss-success(); } }
                }
            }
        }

        if root.show-error: Rectangle {
            width: 100%;
            height: 100%;
            background: #101827aa;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 360px;
                height: 288px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d9e1ea;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: center;

                    Image { source: @image-url("../../../assets/crying_cat_3d.png"); width: 72px; height: 72px; }
                    Text { text: root.error-title; color: #16202e; font-size: 20px; font-weight: 850; horizontal-alignment: center; }
                    Text { text: root.error-text; color: #64748b; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }

                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton { horizontal-stretch: 1; height: 38px; label: "Copy"; clicked => { root.request-copy-log(); } }
                        PrimaryButton { horizontal-stretch: 1; height: 38px; label: "Close"; accent: #7c4b4b; clicked => { root.request-dismiss-error(); } }
                    }
                }
            }
        }
    }
}
